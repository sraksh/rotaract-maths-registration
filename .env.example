# ---------------------------------------------------------------------------
# Frontend build-time variables (PUBLIC — they are embedded in the static site)
# Only put values here that are safe to publish.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE (anon) key only. NEVER put the service-role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Base path for the static build.
#   GitHub Pages project site: /<repo-name>/
#   Netlify / custom domain / root site:  /
# (Copy this file to .env.local for local development; .env.local is git-ignored.)
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# Edge Function secrets (PRIVATE — set with `supabase secrets set`, never commit)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into hosted Edge Functions automatically; you do not set them yourself.
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed to call the functions from a browser.
# Origin = scheme + host only (no path). Example for the hosted site plus local dev:
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173

# Random salt used to hash client IPs for rate limiting (generate with: openssl rand -hex 32)
IP_HASH_SALT=replace-with-a-long-random-value

# Shared secret that protects the scheduled `cleanup` function (openssl rand -hex 32)
CLEANUP_SECRET=replace-with-a-long-random-value

# Optional rate-limit tuning (requests per 10 minutes per client IP)
RATE_LIMIT_INIT_PER_10_MIN=30
RATE_LIMIT_SUBMIT_PER_10_MIN=30
